// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Name {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  name        String   @unique
  description String   @default("") @db.MediumText
  score       Int      @default(0)

  votes Int @default(0)

  uniqueness               Int    @default(0)
  uniquenessDescription    String @default("") @db.MediumText
  memorability             Int    @default(0)
  memorabilityDescription  String @default("") @db.MediumText
  pronunciation            Int    @default(0)
  pronunciationDescription String @default("") @db.MediumText
  spelling                 Int    @default(0)
  spellingDescription      String @default("") @db.MediumText
  positivity               Int    @default(0)
  positivityDescription    String @default("") @db.MediumText
  versatility              Int    @default(0)
  versatilityDescription   String @default("") @db.MediumText
  globalAppeal             Int    @default(0)
  globalAppealDescription  String @default("") @db.MediumText

  // Self relation
  similarNames Name[] @relation("SimilarNames")
  similarTo    Name[] @relation("SimilarNames")
}
